"""Sample .env file for AI Risk Inventory Scanner integration testing.

This fixture file contains representative environment variable references
for multiple AI providers. It is used by the detector and scanner integration
tests to verify that the detection engine correctly identifies API keys,
tokens, and endpoint configurations across all supported providers.

NOTE: All values below are placeholder strings only. No real credentials
are stored in this file. This file is intentionally committed to the
test fixtures directory for testing purposes.
"""

# ===========================================================================
# OpenAI
# ===========================================================================
OPENAI_API_KEY=sk-placeholder-openai-key-for-testing-only-not-real
OPENAI_ORG_ID=org-placeholder-organization-id
OPENAI_BASE_URL=https://api.openai.com/v1

# ===========================================================================
# Anthropic / Claude
# ===========================================================================
ANTHROPIC_API_KEY=sk-ant-placeholder-anthropic-key-for-testing-only
CLAUDE_API_KEY=sk-ant-placeholder-claude-key-for-testing
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ===========================================================================
# Google Vertex AI / Gemini
# ===========================================================================
GEMINI_API_KEY=placeholder-gemini-api-key-for-testing
GOOGLE_API_KEY=placeholder-google-api-key-for-testing
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GOOGLE_CLOUD_PROJECT=my-test-project-id
GOOGLE_CLOUD_REGION=us-central1

# ===========================================================================
# Azure OpenAI Service
# ===========================================================================
AZURE_OPENAI_API_KEY=placeholder-azure-openai-key-for-testing
AZURE_OPENAI_ENDPOINT=https://my-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-01

# ===========================================================================
# AWS Bedrock / SageMaker
# ===========================================================================
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=placeholder-aws-secret-key-for-testing
AWS_SESSION_TOKEN=placeholder-aws-session-token-for-testing
AWS_DEFAULT_REGION=us-east-1
BEDROCK_ENDPOINT=https://bedrock-runtime.amazonaws.com
AWS_BEDROCK_MODEL_ID=anthropic.claude-v2
SAGEMAKER_ENDPOINT=my-sagemaker-endpoint
SAGEMAKER_ENDPOINT_NAME=my-sagemaker-endpoint-name
SAGEMAKER_REGION=us-east-1

# ===========================================================================
# Hugging Face
# ===========================================================================
HF_TOKEN=hf_placeholder_huggingface_token_for_testing_only
