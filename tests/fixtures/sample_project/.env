# ===========================================================================
# Application settings (non-AI, for context)
# ===========================================================================
DEBUG=false
LOG_LEVEL=INFO
APP_ENV=testing
PORT=8000
DATABASE_URL=postgresql://user:password@localhost:5432/mydb
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=placeholder-app-secret-key-not-real
